local function newDraw(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function buildESP(player)
    if player == LocalPlayer then return end
    if espObjs[player] then return end
    
    espObjs[player] = {
        fill = newDraw("Square", {
            Visible      = false,
            Color        = CFG.FillColor,
            Transparency = CFG.FillAlpha,
            Filled       = true,
            Thickness    = 0,
            ZIndex       = 1,
        }),
        box = newDraw("Square", {
            Visible      = false,
            Color        = CFG.BoxColor,
            Transparency = 1,
            Filled       = false,
            Thickness    = CFG.BoxThick,
            ZIndex       = 2,
        }),
        name = newDraw("Text", {
            Visible      = false,
            Color        = CFG.NameColor,
            Size         = CFG.NameSize,
            Font         = Drawing.Fonts.UI,
            Outline      = true,
            OutlineColor = Color3.fromRGB(0, 0, 0),
            Center       = true,
            ZIndex       = 3,
        }),
        healthBack = newDraw("Square", {
            Visible      = false,
            Color        = Color3.fromRGB(20, 20, 20),
            Transparency = 1,
            Filled       = true,
            Thickness    = 1,
            ZIndex       = 2,
        }),
        healthBar = newDraw("Square", {
            Visible      = false,
            Color        = Color3.fromRGB(0, 255, 100),
            Transparency = 1,
            Filled       = true,
            Thickness    = 1,
            ZIndex       = 3,
        }),
    }
end

local function removeESP(player)
    local obj = espObjs[player]
    if not obj then return end
    pcall(function()
        for _, d in pairs(obj) do d.Visible = false; d:Remove() end
    end)
    espObjs[player] = nil
end

Players.PlayerRemoving:Connect(removeESP)
for _, p in ipairs(Players:GetPlayers()) do buildESP(p) end
