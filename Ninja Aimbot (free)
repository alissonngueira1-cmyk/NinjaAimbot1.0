-- Função de Alvo com Filtros Completos: Anti-Carro + Anti-Parede (Visão Real por Raycast)
local function getClosestTargetInFOV(maxDist)
    local selected = nil
    local shortestDistanceToCenter = math.huge
    local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local currentFOVRadius = Config.FOVSize * 2

    for _, enemy in ipairs(Players:GetPlayers()) do
        if enemy ~= LocalPlayer then
            local character = enemy.Character
            local head = character and character:FindFirstChild("Head")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")

            if head and humanoid and humanoid.Health > 0 and rootPart then
                -- 1. Filtro Anti-Carro
                local isDrivingOrSitting = false
                if humanoid.SeatPart then
                    isDrivingOrSitting = true
                else
                    for _, child in ipairs(rootPart:GetChildren()) do
                        if child:IsA("Weld") and child.Part1 and (child.Part1.Name:lower():find("seat") or child.Part1.Parent.Name:lower():find("car") or child.Part1.Parent.Name:lower():find("vehicle")) then
                            isDrivingOrSitting = true
                            break
                        end
                    end
                end

                if not isDrivingOrSitting then
                    -- 2. Filtro de Linha de Visão (Raycast Anti-Parede)
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, character}
                    raycastParams.IgnoreWater = true

                    local origin = Camera.CFrame.Position
                    local direction = (head.Position - origin)
                    local raycastResult = workspace:Raycast(origin, direction, raycastParams)

                    local isVisible = (raycastResult == nil)

                    if isVisible then
                        local vector, onScreen = Camera:WorldToViewportPoint(head.Position)
                        local distanceToCamera = (head.Position - Camera.CFrame.Position).Magnitude

                        if onScreen and distanceToCamera <= maxDist then
                            local screenPos = Vector2.new(vector.X, vector.Y)
                            local distanceFromCenter = (screenPos - centerScreen).Magnitude

                            if distanceFromCenter <= currentFOVRadius then
                                if distanceFromCenter < shortestDistanceToCenter then
                                    shortestDistanceToCenter = distanceFromCenter
                                    selected = head
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return selected
end

-- Loop Principal Protegido
RunService.RenderStepped:Connect(function()
    pcall(function()
        FOVFrame.Position = UDim2.new(0, Camera.ViewportSize.X / 2, 0, Camera.ViewportSize.Y / 2)

        if Config.ShowFOV then
            FOVFrame.Visible = true
            local diameter = Config.FOVSize * 4
            FOVFrame.Size = UDim2.new(0, diameter, 0, diameter)
        else
            FOVFrame.Visible = false
        end

        -- Aimbot Normal (Firme na cabeça, somente visível)
        if Config.Aimbot and isHoldingTouch then
            local targetHead = getClosestTargetInFOV(220)
            if targetHead then
                local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.92) 
            end
        end

        -- Aimbot Legit (Leve mexidinha, somente visível)
        if Config.AimbotLegit and isHoldingTouch then
            local targetHead = getClosestTargetInFOV(180)
            if targetHead then
                local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.28) 
            end
        end

        for player, cache in pairs(espCache) do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")

            if not root or not head or not hum or hum.Health <= 0 then
                cache.BoxHolder.Enabled = false
                cache.NameHolder.Enabled = false
            else
                cache.BoxHolder.Enabled = true
                cache.BoxHolder.Adornee = root
                cache.Box.Visible = Config.ESPBox

                cache.NameHolder.Enabled = true
                cache.NameHolder.Adornee = head
                cache.Name.Visible = Config.ESPName
            end
        end
    end)
end)

