-- Sistema de ESP Estável (Nome e Box)
local espCache = {}

local function createESPUI(player)
    if player == LocalPlayer then return end
    if espCache[player] then return end

    local boxHolder = Instance.new("BillboardGui")
    boxHolder.Name = player.Name .. "_BoxESP"
    boxHolder.AlwaysOnTop = true
    boxHolder.Size = UDim2.new(4, 0, 5.5, 0)
    boxHolder.StudsOffset = Vector3.new(0, 0, 0)
    boxHolder.Enabled = false
    boxHolder.Parent = FOVGui

    local box = Instance.new("Frame")
    box.Name = "Box"
    box.Parent = boxHolder
    box.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
    box.BackgroundTransparency = 0.85
    box.Size = UDim2.new(1, 0, 1, 0)
    box.Visible = false

    local stroke = Instance.new("UIStroke")
    stroke.Parent = box
    stroke.Color = Color3.fromRGB(255, 60, 60)
    stroke.Thickness = 1.5

    local nameHolder = Instance.new("BillboardGui")
    nameHolder.Name = player.Name .. "_NameESP"
    nameHolder.AlwaysOnTop = true
    nameHolder.Size = UDim2.new(0, 200, 0, 50)
    nameHolder.StudsOffset = Vector3.new(0, 1.8, 0)
    nameHolder.Enabled = false
    nameHolder.Parent = FOVGui

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Name = "Name"
    nameLbl.Parent = nameHolder
    nameLbl.BackgroundTransparency = 1
    nameLbl.Position = UDim2.new(0, 0, 0, 0)
    nameLbl.Size = UDim2.new(1, 0, 1, 0)
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.Text = player.DisplayName
    nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLbl.TextSize = 12
    nameLbl.TextStrokeTransparency = 0
    nameLbl.ZIndex = 10
    nameLbl.Visible = false

    espCache[player] = { 
        BoxHolder = boxHolder, 
        Box = box, 
        NameHolder = nameHolder, 
        Name = nameLbl 
    }
end

local function removeESPUI(player)
    if espCache[player] then
        pcall(function() 
            espCache[player].BoxHolder:Destroy() 
            espCache[player].NameHolder:Destroy()
        end)
        espCache[player] = nil
    end
end

Players.PlayerRemoving:Connect(removeESPUI)
