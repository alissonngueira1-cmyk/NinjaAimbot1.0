local function getClosestTarget(maxDist, maxAngle)
    local selected = nil
    local smallestAngle = maxAngle

    for _, enemy in ipairs(Players:GetPlayers()) do
        if enemy ~= LocalPlayer then
            local character = enemy.Character
            local head = character and character:FindFirstChild("Head")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                local direction = head.Position - Camera.CFrame.Position
                local distance = direction.Magnitude
                local _, onScreen = Camera:WorldToViewportPoint(head.Position)

                if onScreen and distance <= maxDist then
                    local angle = math.deg(math.acos(math.clamp(
                        Camera.CFrame.LookVector:Dot(direction.Unit),
                        -1, 1
                    )))

                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = {LocalPlayer.Character, character}
                    params.IgnoreWater = true

                    local hit = workspace:Raycast(Camera.CFrame.Position, direction, params)
                    if not hit and angle < smallestAngle then
                        smallestAngle = angle
                        selected = head
                    end
                end
            end
        end
    end
    return selected
end

local CORNERS = {
    Vector3.new( 1.5,  3.2,  1.5),
    Vector3.new(-1.5,  3.2,  1.5),
    Vector3.new( 1.5,  3.2, -1.5),
    Vector3.new(-1.5,  3.2, -1.5),
    Vector3.new( 1.5, -3.0,  1.5),
    Vector3.new(-1.5, -3.0,  1.5),
    Vector3.new( 1.5, -3.0, -1.5),
    Vector3.new(-1.5, -3.0, -1.5),
}

-- RenderStepped Principal
RunService.RenderStepped:Connect(function()
    pcall(function()
        if Config.ShowFOV then
            FOVCircle.Visible = true
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            FOVCircle.Radius = Config.FOVSize * 2
        else
            FOVCircle.Visible = false
        end

        if Config.Aimbot then
            local targetHead = getClosestTarget(180, 30)
            if targetHead then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetHead.Position), 0.75)
            end
        end

        if Config.AimbotLegit and not isMovingCamera then
            local targetHead = getClosestTarget(150, 25)
            if targetHead then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetHead.Position), 0.35)
            end
        end

        for player, obj in pairs(espObjs) do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")

            if not root or not hum or hum.Health <= 0 then
                hideObj(obj)
            else
                local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
                local anyVis = false

                for _, offset in ipairs(CORNERS) do
                    local wp = root.CFrame:PointToWorldSpace(offset)
                    local sp, vis = Camera:WorldToViewportPoint(wp)
                    if vis then
                        anyVis = true
                        if sp.X < minX then minX = sp.X end
                        if sp.Y < minY then minY = sp.Y end
                        if sp.X > maxX then maxX = sp.X end
                        if sp.Y > maxY then maxY = sp.Y end
                    end
                end

                if not anyVis then
                    hideObj(obj)
                else
                    local w = maxX - minX
                    local h = maxY - minY

                    if Config.ESPBox then
                        obj.fill.Position = Vector2.new(minX, minY)
                        obj.fill.Size     = Vector2.new(w, h)
                        obj.fill.Visible  = true

                        obj.box.Position  = Vector2.new(minX, minY)
                        obj.box.Size      = Vector2.new(w, h)
                        obj.box.Visible   = true
                    else
                        obj.fill.Visible = false
                        obj.box.Visible  = false
                    end

                    if Config.ESPName then
                        obj.name.Text     = player.DisplayName
                        obj.name.Position = Vector2.new(minX + w / 2, minY - CFG.NameSize - 4)
                        obj.name.Visible  = true
                    else
                        obj.name.Visible  = false
                    end

                    if Config.ESPHealth and hum.MaxHealth > 0 then
                        local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        local barHeight = h * healthPercent
                        
                        obj.healthBack.Position = Vector2.new(minX - 6, minY)
                        obj.healthBack.Size     = Vector2.new(3, h)
                        obj.healthBack.Visible  = true

                        obj.healthBar.Position  = Vector2.new(minX - 5.5, minY + (h - barHeight))
                        obj.healthBar.Size      = Vector2.new(2, barHeight)
                        obj.healthBar.Visible   = true
                    else
                        obj.healthBack.Visible  = false
                        obj.healthBar.Visible   = false
                    end
                end
            end
        end
    end)
end)

