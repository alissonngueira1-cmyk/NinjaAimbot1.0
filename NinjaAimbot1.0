local minimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    MinimizeBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    task.delay(0.1, function()
        MinimizeBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    end)
    
    if minimized then
        MinimizeBtn.Text = "+"
        Container.Visible = false
        MainFrame:TweenSize(UDim2.new(0, 300, 0, 35), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
    else
        MinimizeBtn.Text = "-"
        Container.Visible = true
        MainFrame:TweenSize(UDim2.new(0, 300, 0, 340), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
    end
end)

local function CreateSection(text, posY)
    local indicator = Instance.new("Frame")
    indicator.Parent = Container
    indicator.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    indicator.BorderSizePixel = 0
    indicator.Position = UDim2.new(0, 10, 0, posY)
    indicator.Size = UDim2.new(0, 2, 0, 10)
    
    local label = Instance.new("TextLabel")
    label.Parent = Container
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 16, 0, posY - 5)
    label.Size = UDim2.new(1, -20, 0, 20)
    label.Font = Enum.Font.GothamBold
    label.TextColor3 = Color3.fromRGB(190, 190, 190)
    label.TextSize = 10
    label.Text = text
    label.TextXAlignment = Enum.TextXAlignment.Left
end

local function CreateToggle(configKey, name, posY)
    local frame = Instance.new("TextButton")
    frame.Parent = Container
    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0, 10, 0, posY)
    frame.Size = UDim2.new(1, -20, 0, 26)
    frame.Text = ""
    frame.AutoButtonColor = false
    
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Parent = frame
    titleLbl.BackgroundTransparency = 1
    titleLbl.Position = UDim2.new(0, 0, 0.5, -7)
    titleLbl.Size = UDim2.new(1, -45, 0, 14)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.Text = name
    titleLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    titleLbl.TextSize = 11
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local switchBg = Instance.new("Frame")
    switchBg.Parent = frame
    switchBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    switchBg.BorderColor3 = Color3.fromRGB(45, 45, 45)
    switchBg.Position = UDim2.new(1, -38, 0.5, -9)
    switchBg.Size = UDim2.new(0, 38, 0, 18)
    
    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switchBg
    
    local switchCircle = Instance.new("Frame")
    switchCircle.Parent = switchBg
    switchCircle.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
    switchCircle.Position = UDim2.new(0, 2, 0.5, -7)
    switchCircle.Size = UDim2.new(0, 14, 0, 14)
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = switchCircle
    
    frame.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        
        if Config[configKey] then
            switchBg.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
            switchCircle.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
            switchCircle:TweenPosition(UDim2.new(1, -16, 0.5, -7), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        else
            switchBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            switchCircle.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
            switchCircle:TweenPosition(UDim2.new(0, 2, 0.5, -7), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        end
    end)
end

