-- // Ninja Aimbot 1.0 - Release Ready (Delta Optimized & ESP Fixed)
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Limpeza de instâncias anteriores
if CoreGui:FindFirstChild("NinjaAimbotGUI") then
    CoreGui.NinjaAimbotGUI:Destroy()
end

local Config = {
    Aimbot = false,
    AimbotLegit = false,
    ShowFOV = false,
    FOVSize = 50,
    ESPName = false,
    ESPBox = false,
    ESPHealth = false
}

-- Círculo de FOV
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Transparency = 0.7
FOVCircle.Thickness = 1.2
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Filled = false
FOVCircle.Radius = Config.FOVSize * 2

local espCache = {}

local function removeESP(player)
    if espCache[player] then
        if espCache[player].Box then espCache[player].Box:Remove() end
        if espCache[player].NameText then espCache[player].NameText:Remove() end
        if espCache[player].HealthBack then espCache[player].HealthBack:Remove() end
        if espCache[player].HealthBar then espCache[player].HealthBar:Remove() end
        espCache[player] = nil
    end
end

Players.PlayerRemoving:Connect(removeESP)

-- Controlo de toque para Anti-Kick
local isMovingCamera = false
UserInputService.TouchStarted:Connect(function()
    isMovingCamera = true
end)
UserInputService.TouchEnded:Connect(function()
    task.delay(0.12, function()
        isMovingCamera = false
    end)
end)

local function getClosestTarget(maxDist, maxAngle)
    local selected = nil
    local smallestAngle = maxAngle

    for _, enemy in ipairs(Players:GetPlayers()) do
        if enemy ~= LocalPlayer then
            local character = enemy.Character
            local head = character and character:FindFirstChild("Head")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                local direction = head.Position - Camera.CFrame.Position
                local distance = direction.Magnitude
                local _, onScreen = Camera:WorldToViewportPoint(head.Position)

                if onScreen and distance <= maxDist then
                    local angle = math.deg(math.acos(math.clamp(
                        Camera.CFrame.LookVector:Dot(direction.Unit),
                        -1, 1
                    )))

                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = {LocalPlayer.Character, character}
                    params.IgnoreWater = true

                    local hit = workspace:Raycast(Camera.CFrame.Position, direction, params)
                    if not hit and angle < smallestAngle then
                        smallestAngle = angle
                        selected = head
                    end
                end
            end
        end
    end
    return selected
end

-- Loop principal
RunService.RenderStepped:Connect(function()
    if Config.ShowFOV then
        FOVCircle.Visible = true
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Radius = Config.FOVSize * 2
    else
        FOVCircle.Visible = false
    end

    if Config.Aimbot then
        local targetHead = getClosestTarget(180, 30)
        if targetHead then
            local goalCFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, 0.75)
        end
    end

    if Config.AimbotLegit and not isMovingCamera then
        local targetHead = getClosestTarget(150, 25)
        if targetHead then
            local goalCFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, 0.35)
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            local head = character and character:FindFirstChild("Head")

            if character and humanoid and rootPart and head and humanoid.Health > 0 then
                if not espCache[player] then
                    espCache[player] = {
                        Box = Drawing.new("Square"),
                        NameText = Drawing.new("Text"),
                        HealthBack = Drawing.new("Square"),
                        HealthBar = Drawing.new("Square")
                    }
                    
                    espCache[player].Box.Thickness = 1
                    espCache[player].Box.Color = Color3.fromRGB(255, 255, 255)
                    espCache[player].Box.Filled = false
                    
                    espCache[player].NameText.Size = 12
                    espCache[player].NameText.Center = true
                    espCache[player].NameText.Outline = true
                    espCache[player].NameText.Color = Color3.fromRGB(255, 255, 255)
                    
                    espCache[player].HealthBack.Thickness = 1
                    espCache[player].HealthBack.Color = Color3.fromRGB(20, 20, 20)
                    espCache[player].HealthBack.Filled = true
                    
                    espCache[player].HealthBar.Thickness = 1
                    espCache[player].HealthBar.Color = Color3.fromRGB(0, 255, 100)
                    espCache[player].HealthBar.Filled = true
                end
                
                local cache = espCache[player]
                local rootVector, rootOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
                
                -- Validação estricta de profundidade (Z > 0) para evitar que o ESP fique preso no canto superior
                if rootOnScreen and rootVector.Z > 0 then
                    local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local legPos, legOnScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 2.5, 0))
                    
                    if headOnScreen and legOnScreen then
                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height / 2
                        local boxPos = Vector2.new(rootVector.X - width / 2, headPos.Y)
                        local boxSize = Vector2.new(width, height)
                        
                        if Config.ESPBox then
                            cache.Box.Visible = true
                            cache.Box.Size = boxSize
                            cache.Box.Position = boxPos
                        else
                            cache.Box.Visible = false
                        end
                        
                        if Config.ESPName then
                            cache.NameText.Visible = true
                            cache.NameText.Text = player.Name
                            cache.NameText.Position = Vector2.new(boxPos.X + (width / 2), boxPos.Y - 16)
                        else
                            cache.NameText.Visible = false
                        end
                        
                        if Config.ESPHealth and humanoid.MaxHealth > 0 then
                            local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                            local barHeight = height * healthPercent
                            
                            cache.HealthBack.Visible = true
                            cache.HealthBack.Size = Vector2.new(3, height)
                            cache.HealthBack.Position = Vector2.new(boxPos.X - 6, boxPos.Y)
                            
                            cache.HealthBar.Visible = true
                            cache.HealthBar.Size = Vector2.new(2, barHeight)
                            cache.HealthBar.Position = Vector2.new(boxPos.X - 5.5, boxPos.Y + (height - barHeight))
                        else
                            cache.HealthBack.Visible = false
                            cache.HealthBar.Visible = false
                        end
                    else
                        cache.Box.Visible = false
                        cache.NameText.Visible = false
                        cache.HealthBack.Visible = false
                        cache.HealthBar.Visible = false
                    end
                else
                    cache.Box.Visible = false
                    cache.NameText.Visible = false
                    cache.HealthBack.Visible = false
                    cache.HealthBar.Visible = false
                end
            else
                removeESP(player)
            end
        end
    end
end)

